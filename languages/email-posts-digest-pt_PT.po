#. Plugin Name of the plugin
msgid "Email Posts Digest"
msgstr "Resumo de Publicações por Email"

#. Plugin URI of the plugin
msgid "https://github.com/moveyourdigital/wp-email-posts-digest"
msgstr "https://github.com/moveyourdigital/wp-email-posts-digest"

#. Description of the plugin
msgid "Automatically send summarized updates of your latest WordPress posts to all registered users."
msgstr "Envie automaticamente atualizações resumidas dos seus posts mais recentes no WordPress para todos os utilizadores registados."

#. Author of the plugin
msgid "Move Your Digital, Inc."
msgstr "Move Your Digital, Inc."

#. Author URI of the plugin
msgid "https://moveyourdigital.com"
msgstr "https://moveyourdigital.com"

